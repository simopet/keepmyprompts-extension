{
  "name": "keepmyprompts-extension",
  "version": "0.1.2",
  "private": true,
  "description": "Keep My Prompts browser extension: captures the prompts you send in Claude, scores them and offers a one-click Quick Optimize.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:store": "KMP_STORE_ZIP=1 wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.6.0",
    "wxt": "^0.21.4"
  }
}
